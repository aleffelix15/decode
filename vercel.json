{
  "buildCommand": "cd decode-project && npm run build",
  "devCommand": "cd decode-project && npm run dev",
  "installCommand": "cd decode-project && npm install",
  "outputDirectory": "decode-project/dist",
  "routes": [
    {
      "src": "^/(?!.*\\.).*$",
      "dest": "/index.html"
    },
    {
      "src": "/.*",
      "dest": "/$0"
    }
  ]
}
